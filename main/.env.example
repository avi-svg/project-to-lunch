# Copy this file to `.env` and replace the value with your real Supabase
# connection string. If your password contains special URL characters such as
# `$`, `&`, `,`, `/`, or `@`, URL-encode them before saving the final value.
#
# The raw value you provided is kept below for reference:
# DATABASE_URL=postgresql://postgres:E$&A.,/L9BfU4mP@db.apskcgwodnxgmqinsrqp.supabase.co:5432/postgres

DATABASE_URL=postgresql://postgres:E%24%26A.%2C%2FL9BfU4mP@db.apskcgwodnxgmqinsrqp.supabase.co:5432/postgres

# Optional pool tuning for hosted Postgres.
PGPOOL_MAX=5
PGIDLE_TIMEOUT=10000
PGCONNECT_TIMEOUT=10000

# Mail transport for OTP emails.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
MAIL_FROM=no-reply@example.com

# OTP security settings.
OTP_LENGTH=6
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# Internal server-to-server API access.
INTERNAL_API_KEY=replace-with-a-long-random-string

# WhatsApp Cloud API.
WHATSAPP_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
WHATSAPP_PHONE_NUMBER_ID=123456789012345
WHATSAPP_GRAPH_API_VERSION=v23.0
WHATSAPP_DEFAULT_COUNTRY_CODE=972
WHATSAPP_SHIFT_ASSIGNMENT_TEMPLATE_NAME=shift_assignment_notification
WHATSAPP_SHIFT_ASSIGNMENT_TEMPLATE_LANGUAGE_CODE=he
WHATSAPP_SHIFT_REMINDER_TEMPLATE_NAME=remember
WHATSAPP_SHIFT_REMINDER_TEMPLATE_LANGUAGE_CODE=he
WHATSAPP_SHIFT_REMINDER_SCHEDULER_ENABLED=true

# Twilio Verify for phone authentication.
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your-twilio-auth-token
# Alternatively, you can use API Key credentials instead of Account SID/Auth Token.
# TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_SECRET=your-twilio-api-secret
