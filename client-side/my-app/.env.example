AUTH_SECRET=replace-this-with-a-long-random-string
NEXTAUTH_SECRET=replace-this-with-the-same-random-string-if-you-prefer-nextauth-naming
NEXTAUTH_URL=http://localhost:3001
AUTH_GOOGLE_ID=your-google-client-id
AUTH_GOOGLE_SECRET=your-google-client-secret
API_BASE_URL=http://localhost:3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:3000
INTERNAL_API_KEY=replace-this-with-the-same-secret-used-by-the-express-server
